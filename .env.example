# Gebruik echte environmentvariabelen; dit bestand bevat uitsluitend placeholders.
MCP_BEARER_TOKEN=replace-with-at-least-32-random-bytes
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=user@example.com
IMAP_PASSWORD=replace-me
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM_ADDRESS=user@example.com
MAIL_NOVALIDATE_CERT=false
MAIL_SOCKET_TIMEOUT=5
DEBUG=false
DEBUG_MAIL=false
