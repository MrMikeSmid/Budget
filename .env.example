# Kopieer dit bestand naar .env voor lokale ontwikkeling.
# Op gedeelde hosting (cPanel/Plesk "Node.js App") zet je deze variabelen
# via het hostingpaneel zelf, niet in een .env-bestand op de server.

# ---- MCP-server ----
# Poort waarop de server luistert (cPanel/Passenger geeft dit vaak automatisch mee via PORT).
PORT=3000

# Verplicht: bearer token waarmee Claude zich bij deze server authenticeert.
# Genereer bv. met: openssl rand -hex 32
MCP_BEARER_TOKEN=

# ---- Enkel account (MVP) ----
IMAP_HOST=mail.jouwdomein.nl
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=jij@jouwdomein.nl
IMAP_PASSWORD=

SMTP_HOST=mail.jouwdomein.nl
SMTP_PORT=587
# SMTP_SECURE=true hoort bij poort 465 (impliciete TLS). Bij 587 (STARTTLS) op false laten.
SMTP_SECURE=false
# Optioneel: alleen invullen als SMTP-gebruiker/wachtwoord afwijken van IMAP.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=jij@jouwdomein.nl
SMTP_FROM_NAME=Jouw Naam

# ---- Meerdere accounts (optioneel, in plaats van de losse variabelen hierboven) ----
