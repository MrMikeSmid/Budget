# Fallback safety net for when this entire repository ends up inside a
# web-accessible folder (e.g. document root could not be pointed at
# public/ on this hosting). Denies direct web access to everything except
# the public/ folder, which has its own .htaccess re-allowing access.
# If the hosting document root is already set to public/ directly, this
# file simply has no effect (it lives above the web root).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
