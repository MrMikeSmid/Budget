# Re-allow access within public/, overriding the deny-all in the parent
# .htaccess (only relevant if the whole repo was uploaded under the web
# root instead of pointing the document root at this folder directly).
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>
