{
  "name": "mcp-email-connector",
  "version": "1.0.0",
  "description": "Self-hosted MCP server exposing an IMAP/SMTP mailbox to Claude via Streamable HTTP",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.0.176",
    "mailparser": "^3.7.2",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
